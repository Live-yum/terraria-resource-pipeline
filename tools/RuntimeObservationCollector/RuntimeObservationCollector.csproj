<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <OutputType>Exe</OutputType><AssemblyName>RuntimeObservationCollector</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion><PlatformTarget>x86</PlatformTarget>
    <OutputPath>bin\</OutputPath><Optimize>true</Optimize><DebugType>none</DebugType>
